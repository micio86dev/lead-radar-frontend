---
import ConfirmSubmit from '../../components/ConfirmSubmit.vue';
import EmptyState from '../../components/EmptyState.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Layout from '../../layouts/Layout.astro';
import { api } from '../../lib/api/client';
import { formatDateTime, formatNumber, label, scoreClass } from '../../lib/format';
import { load, pageLink, param, formTarget } from '../../lib/page';

const url = Astro.url;
const verticals = [
  'hr_recruiting',
  'international_meetings',
  'conferences_webinars',
  'customer_support',
  'tourism_hospitality',
  'other',
];
const intents = [
  'explicit_solution_request',
  'active_problem',
  'latent_problem',
  'product_comparison',
  'general_discussion',
  'irrelevant',
];
const categories = ['hot', 'warm', 'potential', 'low'];
const reviews = ['none', 'pending', 'in_review', 'resolved'];

const asTimestamp = (value: string, endOfDay = false): string | undefined => {
  if (!value) return undefined;
  if (/^\d{4}-\d{2}-\d{2}$/.test(value)) {
    return `${value}T${endOfDay ? '23:59:59' : '00:00:00'}Z`;
  }
  return value;
};

/**
 * The inbox is a triage queue, not an archive: by default it shows the leads worth a human look, and
 * a lead is worth a look at 60/100 or more. The threshold is visible, editable and escapable — a
 * default that hides rows without saying so would be a trap.
 */
const DEFAULT_MIN_SCORE = 60;
const hasScoreParam = url.searchParams.has('score_min');
const showAllScores = param(url, 'all') === '1';
const parsedMinScore = Number(param(url, 'score_min'));
const minScore: number | null = showAllScores
  ? null
  : hasScoreParam
    ? param(url, 'score_min') === '' || Number.isNaN(parsedMinScore)
      ? null
      : parsedMinScore
    : DEFAULT_MIN_SCORE;

/** Same page, same filters, different score floor. */
const withScoreFloor = (floor: number | null): string => {
  const query = new URLSearchParams(url.searchParams);
  for (const key of ['ok', 'error', 'page', 'all', 'score_min']) query.delete(key);
  if (floor === null) query.set('all', '1');
  else query.set('score_min', String(floor));
  const search = query.toString();
  return search ? `${url.pathname}?${search}` : url.pathname;
};

const params = {
  vertical: param(url, 'vertical') || undefined,
  score_category: param(url, 'score_category') || undefined,
  score_min: minScore === null ? undefined : String(minScore),
  score_max: param(url, 'score_max') || undefined,
  intent: param(url, 'intent') || undefined,
  language: param(url, 'language') || undefined,
  source_id: param(url, 'source_id') || undefined,
  community: param(url, 'community') || undefined,
  published_after: asTimestamp(param(url, 'published_after')),
  published_before: asTimestamp(param(url, 'published_before'), true),
  review_status: param(url, 'review_status') || undefined,
  customer_type: param(url, 'customer_type') || undefined,
  buying_intent: param(url, 'buying_intent') || undefined,
  q: param(url, 'q') || undefined,
  sort: param(url, 'sort') || 'score',
  order: param(url, 'order') || 'desc',
  page: Number(param(url, 'page') || '1'),
  per_page: Number(param(url, 'per_page') || '25'),
};

const { data, error } = await load(() => api.opportunities(params));
/**
 * Only fetched when the floor is active: the header has to say how many leads the floor hides, or the
 * operator cannot tell an empty pipeline from a filtered one.
 */
const unfiltered =
  minScore === null
    ? null
    : await load(() =>
        api.opportunities({ ...params, score_min: undefined, page: 1, per_page: 1 }),
      );

const actors = await load(() => api.actors());
const runnableActors =
  actors.data?.items.filter((actor) => actor.enabled && actor.validation_status === 'validated') ??
  [];
const target = formTarget(url);
/** "1 lead" is not "1 leads": the header is the most-read line on the page. */
const leadCount = (count: number): string =>
  `${formatNumber(count)} ${count === 1 ? 'lead' : 'leads'}`;
const totalPages = data ? Math.max(1, Math.ceil(data.total / data.per_page)) : 1;
---

<Layout title="Opportunities">
  <div class="page-head">
    <div>
      <h1>Opportunities</h1>
      <p class="muted small">
        {
          data
            ? minScore === null
              ? `${leadCount(data.total)}, all scores`
              : `${leadCount(data.total)} with score ≥ ${minScore}` +
                (unfiltered?.data ? ` of ${formatNumber(unfiltered.data.total)}` : '')
            : 'Loading…'
        }
        {
          minScore === null ? (
            <a
              href={withScoreFloor(DEFAULT_MIN_SCORE)}
              class="ml-2 font-semibold text-accent hover:underline"
            >
              Back to score ≥ {DEFAULT_MIN_SCORE}
            </a>
          ) : (
            <a href={withScoreFloor(null)} class="ml-2 font-semibold text-accent hover:underline">
              Show all scores
            </a>
          )
        }
      </p>
    </div>
    <Button href="/import" variant="secondary" size="sm">Import JSON</Button>
  </div>

  <Card title="Start a search" class="mb-4">
    {
      runnableActors.length === 0 ? (
        <>
          <p class="small">
            There is no validated Actor to run, so a search cannot start yet. An Actor is a
            third-party collector with a verified id, and Lead Radar refuses to invent one.
          </p>
          <Button href="/apify" variant="secondary" size="sm" class="mt-3">
            Open Apify to register an Actor
          </Button>
        </>
      ) : (
        <div class="space-y-4">
          <p class="small muted">
            A run spends Apify credit under the configured budget and can be refused by the cost
            guard. Results arrive as jobs; this page shows them once they are scored.
          </p>
          {runnableActors.map((actor) => (
            <form method="post" action="/api/action">
              <input type="hidden" name="op" value="apify.run.start" />
              <input type="hidden" name="actor_registry_id" value={actor.id} />
              <input type="hidden" name="redirect" value={target} />
              <p class="small">
                <strong>{actor.name}</strong> · {actor.actor_id} · up to{' '}
                {formatNumber(actor.max_items_per_run)} items
              </p>
              <div class="flex flex-wrap items-end gap-3">
                <div>
                  <label for={`items-${actor.id}`}>Items for this run</label>
                  <input
                    id={`items-${actor.id}`}
                    name="items_limit"
                    type="number"
                    min="1"
                    max={actor.max_items_per_run}
                    value={actor.max_items_per_run}
                    class="w-32"
                  />
                </div>
                <ConfirmSubmit
                  label="Start search"
                  confirmation="I understand this run may spend Apify credit"
                  client:load
                />
              </div>
            </form>
          ))}
        </div>
      )
    }
  </Card>

  {actors.error && <p class="notice notice--info">Actor registry unavailable: {actors.error}</p>}

  {
    error && (
      <p class="notice notice--error" role="alert">
        {error}
      </p>
    )
  }

  <form method="get" class="card" aria-label="Opportunity filters">
    <div class="form-row">
      <div>
        <label for="vertical">Vertical</label>
        <select id="vertical" name="vertical">
          <option value="">Any</option>
          {
            verticals.map((value) => (
              <option value={value} selected={params.vertical === value}>
                {label(value)}
              </option>
            ))
          }
        </select>
      </div>
      <div>
        <label for="score_category">Score category</label>
        <select id="score_category" name="score_category">
          <option value="">Any</option>
          {
            categories.map((value) => (
              <option value={value} selected={params.score_category === value}>
                {label(value)}
              </option>
            ))
          }
        </select>
      </div>
      <div>
        <label for="score_min">Score min</label>
        <input
          id="score_min"
          name="score_min"
          type="number"
          min="0"
          max="100"
          value={minScore === null ? '' : String(minScore)}
          aria-describedby="score_min-hint"
        />
        <p id="score_min-hint" class="mt-1 text-xs text-ink-muted">
          Defaults to {DEFAULT_MIN_SCORE}. Empty means no minimum.
        </p>
      </div>
      <div>
        <label for="score_max">Score max</label>
        <input
          id="score_max"
          name="score_max"
          type="number"
          min="0"
          max="100"
          value={param(url, 'score_max')}
        />
      </div>
    </div>
    <div class="form-row">
      <div>
        <label for="intent">Intent</label>
        <select id="intent" name="intent">
          <option value="">Any</option>
          {
            intents.map((value) => (
              <option value={value} selected={params.intent === value}>
                {label(value)}
              </option>
            ))
          }
        </select>
      </div>
      <div>
        <label for="buying_intent">Buying intent</label>
        <select id="buying_intent" name="buying_intent">
          <option value="">Any</option>
          {
            ['none', 'weak', 'moderate', 'strong', 'explicit'].map((value) => (
              <option value={value} selected={params.buying_intent === value}>
                {label(value)}
              </option>
            ))
          }
        </select>
      </div>
      <div>
        <label for="customer_type">Customer type</label>
        <select id="customer_type" name="customer_type">
          <option value="">Any</option>
          {
            ['b2b', 'b2c', 'unknown'].map((value) => (
              <option value={value} selected={params.customer_type === value}>
                {label(value)}
              </option>
            ))
          }
        </select>
      </div>
      <div>
        <label for="language">Language (ISO code)</label>
        <input id="language" name="language" value={param(url, 'language')} placeholder="en" />
      </div>
    </div>
    <div class="form-row">
      <div>
        <label for="community">Community</label>
        <input
          id="community"
          name="community"
          value={param(url, 'community')}
          placeholder="recruiting"
        />
      </div>
      <div>
        <label for="source_id">Source id</label>
        <input id="source_id" name="source_id" value={param(url, 'source_id')} />
      </div>
      <div>
        <label for="review_status">Review status</label>
        <select id="review_status" name="review_status">
          <option value="">Any</option>
          {
            reviews.map((value) => (
              <option value={value} selected={params.review_status === value}>
                {label(value)}
              </option>
            ))
          }
        </select>
      </div>
      <div>
        <label for="q">Search text</label>
        <input id="q" name="q" value={param(url, 'q')} placeholder="keyword" />
      </div>
    </div>
    <div class="form-row">
      <div>
        <label for="published_after">Published after</label>
        <input
          id="published_after"
          name="published_after"
          type="date"
          value={param(url, 'published_after')}
        />
      </div>
      <div>
        <label for="published_before">Published before</label>
        <input
          id="published_before"
          name="published_before"
          type="date"
          value={param(url, 'published_before')}
        />
      </div>
      <div>
        <label for="sort">Sort by</label>
        <select id="sort" name="sort">
          {
            ['score', 'recency', 'buying_intent', 'confidence'].map((value) => (
              <option value={value} selected={params.sort === value}>
                {label(value)}
              </option>
            ))
          }
        </select>
      </div>
      <div>
        <label for="order">Order</label>
        <select id="order" name="order">
          <option value="desc" selected={params.order === 'desc'}>Descending</option>
          <option value="asc" selected={params.order === 'asc'}>Ascending</option>
        </select>
      </div>
    </div>
    <div class="actions">
      <button type="submit">Apply filters</button>
      <a href="/opportunities">Reset</a>
    </div>
  </form>

  {
    data && data.items.length === 0 && (
      <EmptyState
        title="No opportunities match these filters"
        hint="Loosen the filters or import a conversation."
      >
        <Button href="/import" variant="secondary" size="sm" class="mt-3">
          Import JSON
        </Button>
      </EmptyState>
    )
  }

  {
    data && data.items.length > 0 && (
      <>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Opportunity</th>
                <th scope="col">Vertical</th>
                <th scope="col">Intent</th>
                <th scope="col">Type</th>
                <th scope="col">Score</th>
                <th scope="col">Qualification</th>
                <th scope="col">Language</th>
                <th scope="col">Published</th>
              </tr>
            </thead>
            <tbody>
              {data.items.map((item) => (
                <tr>
                  <td>
                    <a href={`/opportunities/${item.id}`}>{item.title ?? '(no title)'}</a>
                    <div class="muted small">
                      {item.community ?? 'unknown community'} · {item.comment_count} comments ·{' '}
                      {item.evidence_count} evidence
                    </div>
                  </td>
                  <td>{label(item.vertical_primary)}</td>
                  <td>{label(item.intent)}</td>
                  <td>{label(item.customer_type)}</td>
                  <td>
                    <span class={scoreClass(item.score_category)}>
                      {label(item.score_category)}
                    </span>
                    <div class="muted small">
                      {item.score ?? 'unknown'} · confidence{' '}
                      {item.confidence === null ? 'unknown' : item.confidence.toFixed(2)}
                    </div>
                  </td>
                  <td>{label(item.qualification_status)}</td>
                  <td>{item.language ?? 'und'}</td>
                  <td>{formatDateTime(item.published_at)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <nav class="actions" aria-label="Pagination">
          <a href={pageLink(url, Math.max(1, data.page - 1))} aria-disabled={data.page <= 1}>
            Previous
          </a>
          <span class="muted small">
            Page {data.page} of {totalPages}
          </span>
          <a
            href={pageLink(url, Math.min(totalPages, data.page + 1))}
            aria-disabled={data.page >= totalPages}
          >
            Next
          </a>
        </nav>
      </>
    )
  }
</Layout>
