---
import ReplyConsole from '../components/vue/ReplyConsole.vue';
import EmptyState from '../components/EmptyState.astro';
import Layout from '../layouts/Layout.astro';
import { api } from '../lib/api/client';
import { load } from '../lib/page';

const { data, error } = await load(() => api.replyConsole(25));
const items = data?.items ?? [];
---

<Layout title="Reply">
  <div class="page-head">
    <h1>Reply</h1>
    <p class="muted small">
      One screen: draft, edit, copy, post on Reddit, record. Nothing is published by this system.
    </p>
  </div>

  {
    error && (
      <p class="notice notice--error" role="alert">
        {error}
      </p>
    )
  }

  {
    data && (
      <p class="muted small">
        {data.stats.ready} ready · {data.stats.needs_drafts} waiting for drafts ·{' '}
        {data.stats.returned} in this queue. Qualified leads come first, then the ones flagged for
        review.
      </p>
    )
  }

  {
    items.length === 0 ? (
      <EmptyState
        title="The reply queue is empty"
        hint="Import a conversation or run a discovery pass; leads that pass the gates appear here."
      />
    ) : (
      <ReplyConsole items={items} client:load />
    )
  }
</Layout>
