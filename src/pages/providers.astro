---
import Layout from '../layouts/Layout.astro';
import { api } from '../lib/api/client';
import { formatAge, formatNumber, label, statusClass } from '../lib/format';
import { formTarget, load } from '../lib/page';

const target = formTarget(Astro.url);
const [providers, benchmarks] = await Promise.all([
  load(() => api.providers()),
  load(() => api.benchmarks()),
]);
const error = providers.error ?? benchmarks.error;
---

<Layout title="AI Providers">
  <div class="page-head">
    <h1>AI Providers</h1>
    <p class="muted small">
      Status comes from configuration and recorded usage. The health check is an explicit, possibly
      billable probe.
    </p>
  </div>

  {
    error && (
      <p class="notice notice--error" role="alert">
        {error}
      </p>
    )
  }

  {
    providers.data && (
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Provider</th>
              <th scope="col">Kind</th>
              <th scope="col">Status</th>
              <th scope="col">Model</th>
              <th scope="col">Configured</th>
              <th scope="col">Requests</th>
              <th scope="col">Tokens in / out</th>
              <th scope="col">Last request</th>
              <th scope="col">Last success</th>
              <th scope="col">Last error</th>
              <th scope="col">Probe</th>
            </tr>
          </thead>
          <tbody>
            {providers.data.map((provider) => (
              <tr>
                <td>{provider.provider}</td>
                <td>{provider.kind}</td>
                <td>
                  <span class={statusClass(provider.status)}>{label(provider.status)}</span>
                </td>
                <td>{provider.model ?? 'unknown'}</td>
                <td>{provider.configured ? 'yes' : 'no'}</td>
                <td>{formatNumber(provider.usage.requests)}</td>
                <td>
                  {formatNumber(provider.usage.input_tokens)} /{' '}
                  {formatNumber(provider.usage.output_tokens)}
                </td>
                <td>{formatAge(provider.last_request_at)}</td>
                <td>{formatAge(provider.last_success_at)}</td>
                <td class="small">
                  {provider.last_error ?? '—'}
                  {provider.last_error && provider.stale && (
                    <div class="muted small">recorded {formatAge(provider.last_error_at)}</div>
                  )}
                </td>
                <td>
                  <form method="post" action="/api/action">
                    <input type="hidden" name="op" value="provider.test" />
                    <input type="hidden" name="provider" value={provider.provider} />
                    <input type="hidden" name="redirect" value={target} />
                    <button type="submit" class="secondary">
                      Test
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <h2>Benchmarks</h2>
  <p><a href="/benchmarks">Open benchmark history</a></p>
  <p class="muted small">
    Active decision provider is chosen by configuration (DECISION_PROVIDER). Laya stays
    benchmark-only unless enabled explicitly.
  </p>
</Layout>
