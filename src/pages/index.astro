---
import EmptyState from '../components/EmptyState.astro';
import Badge from '../components/ui/Badge.astro';
import Card from '../components/ui/Card.astro';
import Notice from '../components/ui/Notice.astro';
import Layout from '../layouts/Layout.astro';
import { api } from '../lib/api/client';
import {
  costSourceLabel,
  formatDateTime,
  formatMoney,
  formatNumber,
  label,
  statusClass,
} from '../lib/format';
import { load } from '../lib/page';

const { data, error } = await load(() => api.dashboard());

/** Score categories the API can return; anything else falls back to the muted tone. */
const scoreTones = ['hot', 'warm', 'potential', 'low'] as const;
type ScoreTone = (typeof scoreTones)[number];

const scoreTone = (category: string | null): ScoreTone =>
  scoreTones.includes(category as ScoreTone) ? (category as ScoreTone) : 'low';

const slices = (rows: { count: number }[]): number => Math.max(1, ...rows.map((row) => row.count));

const share = (count: number, max: number): string =>
  `${Math.max(2, Math.round((count / max) * 100))}%`;
---

<Layout title="Dashboard">
  <div class="page-head">
    <h1>Dashboard</h1>
    <p class="muted small">Live counts from the API. Unknown costs are shown as unknown.</p>
  </div>

  {
    error && (
      <Notice tone="error" role="alert">
        {error}
      </Notice>
    )
  }

  {
    !data && !error && (
      <EmptyState
        title="No data yet"
        hint="Import a conversation or run discovery to populate the inbox."
      />
    )
  }

  {
    data && (
      <>
        <section class="grid grid--stats" aria-label="Opportunity totals">
          <div class="kpi kpi--accent">
            <p class="kpi__label">
              <span class="kpi__dot" />
              Opportunities
            </p>
            <p class="kpi__value">{formatNumber(data.totals.opportunities)}</p>
            <p class="kpi__hint">
              {formatNumber(data.totals.new_opportunities)} new in the last 24h
            </p>
          </div>
          <div class="kpi kpi--hot">
            <p class="kpi__label">
              <span class="kpi__dot" />
              Hot
            </p>
            <p class="kpi__value">{formatNumber(data.totals.hot)}</p>
            <p class="kpi__hint">score 80–100</p>
          </div>
          <div class="kpi kpi--warm">
            <p class="kpi__label">
              <span class="kpi__dot" />
              Warm
            </p>
            <p class="kpi__value">{formatNumber(data.totals.warm)}</p>
            <p class="kpi__hint">score 60–79</p>
          </div>
          <div class="kpi kpi--potential">
            <p class="kpi__label">
              <span class="kpi__dot" />
              Potential
            </p>
            <p class="kpi__value">{formatNumber(data.totals.potential)}</p>
            <p class="kpi__hint">score 40–59</p>
          </div>
          <div class="kpi kpi--low">
            <p class="kpi__label">
              <span class="kpi__dot" />
              Low
            </p>
            <p class="kpi__value">{formatNumber(data.totals.low)}</p>
            <p class="kpi__hint">score 0–39</p>
          </div>
        </section>

        <div class="grid lg:grid-cols-2">
          <Card label="Leads by vertical">
            <h2>By vertical</h2>
            {data.by_vertical.length === 0 ? (
              <p class="muted small">No leads yet.</p>
            ) : (
              <ul class="m-0 list-none space-y-2.5 p-0">
                {data.by_vertical.map((row) => (
                  <li class="bar bar--potential">
                    <span
                      class="w-44 shrink-0 truncate text-sm text-ink"
                      title={label(row.vertical)}
                    >
                      {label(row.vertical)}
                    </span>
                    <span class="bar__track">
                      <span
                        class="bar__fill"
                        style={`--bar-value:${share(row.count, slices(data.by_vertical))}`}
                      />
                    </span>
                    <span class="bar__value">{formatNumber(row.count)}</span>
                  </li>
                ))}
              </ul>
            )}
          </Card>

          <Card label="Leads by intent">
            <h2>By intent</h2>
            {data.by_intent.length === 0 ? (
              <p class="muted small">No leads yet.</p>
            ) : (
              <ul class="m-0 list-none space-y-2.5 p-0">
                {data.by_intent.map((row) => (
                  <li class="bar">
                    <span class="w-44 shrink-0 truncate text-sm text-ink" title={label(row.intent)}>
                      {label(row.intent)}
                    </span>
                    <span class="bar__track">
                      <span
                        class="bar__fill"
                        style={`--bar-value:${share(row.count, slices(data.by_intent))}`}
                      />
                    </span>
                    <span class="bar__value">{formatNumber(row.count)}</span>
                  </li>
                ))}
              </ul>
            )}
          </Card>

          <Card label="Review queue and jobs">
            <h2>Review queue</h2>
            <dl class="kv">
              <>
                <dt>Pending review</dt>
                <dd>{formatNumber(data.review_queue.pending_review)}</dd>
              </>
              <>
                <dt>Needs edit</dt>
                <dd>{formatNumber(data.review_queue.needs_edit)}</dd>
              </>
              <>
                <dt>Approved</dt>
                <dd>{formatNumber(data.review_queue.approved)}</dd>
              </>
            </dl>
            <h3>Jobs</h3>
            <dl class="kv">
              <>
                <dt>Failed</dt>
                <dd>{formatNumber(data.job_failures.failed)}</dd>
              </>
              <>
                <dt>Dead letter</dt>
                <dd>{formatNumber(data.job_failures.dead_letter)}</dd>
              </>
              <>
                <dt>AI decisions</dt>
                <dd>{formatNumber(data.ai_decisions.total)}</dd>
              </>
            </dl>
            <p>
              <a href="/settings">Inspect jobs</a>
            </p>
          </Card>

          <Card label="Apify spending">
            <h2>Apify spending</h2>
            <dl class="kv">
              <>
                <dt>Configured budget</dt>
                <dd>{formatMoney(data.apify.budget_eur, 'EUR')}</dd>
              </>
              <>
                <dt>Daily ceiling</dt>
                <dd>{formatMoney(data.apify.daily_budget_eur, 'EUR')}</dd>
              </>
              <>
                <dt>Known actual (USD)</dt>
                <dd>{formatMoney(data.apify.known_actual_usd, 'USD')}</dd>
              </>
              <>
                <dt>Estimated (USD)</dt>
                <dd>{formatMoney(data.apify.estimated_usd, 'USD')}</dd>
              </>
              <>
                <dt>Remaining known (EUR)</dt>
                <dd>{formatMoney(data.apify.remaining_known_eur, 'EUR')}</dd>
              </>
              <>
                <dt>Runs / results</dt>
                <dd>
                  {formatNumber(data.apify.runs)} / {formatNumber(data.apify.results)}
                </dd>
              </>
              <>
                <dt>Errors</dt>
                <dd>{formatNumber(data.apify.errors)}</dd>
              </>
              <>
                <dt>Cost source</dt>
                <dd>{costSourceLabel(data.apify.cost_source)}</dd>
              </>
              <>
                <dt>Kill switch</dt>
                <dd>{data.apify.kill_switch ? 'ENGAGED' : 'off'}</dd>
              </>
            </dl>
            <p class="muted small">Ceilings are configured in EUR; Apify reports charges in USD.</p>
          </Card>
        </div>

        <div class="section-head">
          <h2>Provider status</h2>
          <p>live state of the configured providers</p>{' '}
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Provider</th>
                <th scope="col">State</th>
                <th scope="col">Model</th>
                <th scope="col" class="numeric">
                  Requests
                </th>
                <th scope="col">Last request</th>
                <th scope="col">Last error</th>
              </tr>
            </thead>
            <tbody>
              {data.providers.map((provider) => (
                <tr>
                  <td>{provider.provider}</td>
                  <td>
                    <span class={statusClass(provider.status)}>{label(provider.status)}</span>
                  </td>
                  <td>{provider.model ?? 'unknown'}</td>
                  <td>{formatNumber(provider.usage.requests)}</td>
                  <td>{formatDateTime(provider.last_request_at)}</td>
                  <td class="small">{provider.last_error ?? '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="section-head">
          <h2>Recent discoveries</h2>
          <p>newest leads first</p>{' '}
        </div>
        {data.recent_opportunities.length === 0 ? (
          <EmptyState
            title="No opportunities yet"
            hint="Import JSON or run a validated Actor to start."
          />
        ) : (
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th scope="col">Opportunity</th>
                  <th scope="col">Vertical</th>
                  <th scope="col">Score</th>
                  <th scope="col">Qualification</th>
                  <th scope="col">Published</th>
                </tr>
              </thead>
              <tbody>
                {data.recent_opportunities.map((item) => (
                  <tr>
                    <td>
                      <a href={`/opportunities/${item.id}`}>{item.title ?? '(no title)'}</a>
                      <div class="muted small">
                        {item.community ?? 'unknown community'} · {item.language ?? 'und'}
                      </div>
                    </td>
                    <td>{label(item.vertical_primary)}</td>
                    <td>
                      <Badge tone={scoreTone(item.score_category)}>
                        {label(item.score_category)}
                      </Badge>
                      <div class="muted small tabular-nums">{item.score ?? 'unknown'}</div>
                    </td>
                    <td>{label(item.qualification_status)}</td>
                    <td>{formatDateTime(item.published_at)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        <div class="section-head">
          <h2>Provider costs (30 days)</h2>
          <p>actual and estimated spend per provider</p>{' '}
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Provider</th>
                <th scope="col" class="numeric">
                  Requests
                </th>
                <th scope="col" class="numeric">
                  Actual
                </th>
                <th scope="col" class="numeric">
                  Estimated
                </th>
                <th scope="col" class="numeric">
                  Unknown cost requests
                </th>
              </tr>
            </thead>
            <tbody>
              {data.costs.map((cost) => (
                <tr>
                  <td>{cost.provider}</td>
                  <td class="numeric">{formatNumber(cost.requests)}</td>
                  <td class="numeric">{formatMoney(cost.actual_cost_usd, cost.currency)}</td>
                  <td class="numeric">{formatMoney(cost.estimated_cost_usd, cost.currency)}</td>
                  <td class="numeric">{formatNumber(cost.unknown_cost_requests)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }
</Layout>
