---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Notice from '../components/ui/Notice.astro';
import { api } from '../lib/api/client';
import { formatDateTime, label } from '../lib/format';
import { formTarget, load, param } from '../lib/page';

const url = Astro.url;
const target = formTarget(url);
const open = param(url, 'project');

const projects = await load(() => api.projects());
const detail = open ? await load(() => api.project(open)) : null;

const rankTone = (relevance: number): 'good' | 'potential' | 'muted' =>
  relevance >= 70 ? 'good' : relevance >= 40 ? 'potential' : 'muted';

const plan = (projects.data?.items ?? []).length;
---

<Layout title="Projects">
  <div class="page-head">
    <h1>Projects</h1>
    <p class="muted small">
      The product each analysis is written for. The default project is the one the drafting prompts
      read; the analysis ranks communities that are already validated and enabled.
    </p>
  </div>

  {
    projects.error && (
      <Notice tone="error" role="alert">
        {projects.error}
      </Notice>
    )
  }

  {
    plan === 0 && (
      <Card title="No project yet">
        <p class="small">
          The drafting prompts need a project: a name, what the product is in your own words, and
          optionally the public pages that describe it. Nothing is invented for you.
        </p>
      </Card>
    )
  }

  {
    (projects.data?.items ?? []).map((project) => (
      <Card class="mb-4">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="m-0 flex items-center gap-2 text-base font-semibold">
            {project.name}
            {project.is_default && <Badge tone="accent">default</Badge>}
          </h2>
          <p class="muted small m-0">updated {formatDateTime(project.updated_at)}</p>
        </div>

        <p class="mt-2 mb-3 text-sm text-ink">
          {project.summary || 'No description yet: the prompts only know the project name.'}
        </p>

        {project.website_urls.length > 0 ? (
          <ul class="m-0 mb-3 list-none space-y-1 p-0 text-xs">
            {project.website_urls.map((site) => (
              <li>
                <a href={site} rel="noreferrer noopener" target="_blank">
                  {site}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="muted small">No page URLs: the analysis judges from the description alone.</p>
        )}

        <div class="flex flex-wrap items-center gap-2">
          <form method="post" action="/api/action">
            <input type="hidden" name="op" value="project.match" />
            <input type="hidden" name="id" value={project.id} />
            <input type="hidden" name="redirect" value={`/projects?project=${project.id}`} />
            <Button type="submit" size="sm">
              Analyse communities
            </Button>
          </form>
          {!project.is_default && (
            <form method="post" action="/api/action">
              <input type="hidden" name="op" value="project.patch" />
              <input type="hidden" name="id" value={project.id} />
              <input type="hidden" name="is_default" value="on" />
              <input type="hidden" name="redirect" value="/projects" />
              <Button type="submit" variant="secondary" size="sm">
                Make default
              </Button>
            </form>
          )}
          <Button href={`/projects?project=${project.id}`} variant="ghost" size="sm">
            Ranking and edit
          </Button>
        </div>

        {detail?.data && detail.data.project.id === project.id && (
          <div class="mt-4 border-t border-line pt-4">
            <h3 class="mt-0 mb-2 text-sm font-semibold">
              Community ranking
              {detail.data.communities.length === 0 && (
                <span class="muted small"> — run the analysis, or no candidate community yet</span>
              )}
            </h3>
            {detail.data.communities.length > 0 && (
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th scope="col">Community</th>
                      <th scope="col">Vertical</th>
                      <th scope="col" class="numeric">
                        Relevance
                      </th>
                      <th scope="col">Why</th>
                      <th scope="col">Active</th>
                    </tr>
                  </thead>
                  <tbody>
                    {detail.data.communities.map((match) => (
                      <tr>
                        <td class="font-semibold">{match.name}</td>
                        <td>{label(match.vertical)}</td>
                        <td class="numeric">
                          <Badge tone={rankTone(match.relevance)}>{match.relevance}</Badge>
                        </td>
                        <td class="small">{match.reason}</td>
                        <td>{match.enabled ? 'yes' : 'no'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            <h3 class="mt-4 mb-2 text-sm font-semibold">Edit</h3>
            <form method="post" action="/api/action">
              <input type="hidden" name="op" value="project.patch" />
              <input type="hidden" name="id" value={detail.data.project.id} />
              <input
                type="hidden"
                name="redirect"
                value={`/projects?project=${detail.data.project.id}`}
              />
              <div class="form-row">
                <div>
                  <label for={`name-${detail.data.project.id}`}>Name</label>
                  <input
                    id={`name-${detail.data.project.id}`}
                    name="name"
                    value={detail.data.project.name}
                  />
                </div>
              </div>
              <label for={`summary-${detail.data.project.id}`}>What the product is</label>
              <textarea
                id={`summary-${detail.data.project.id}`}
                name="summary"
                rows="4"
                aria-describedby={`summary-hint-${detail.data.project.id}`}
              >
                {detail.data.project.summary}
              </textarea>
              <p id={`summary-hint-${detail.data.project.id}`} class="mt-1 text-xs text-ink-muted">
                The drafting prompts quote this. Describe the problem it solves; never add claims
                about pricing or integrations.
              </p>
              <label for={`urls-${detail.data.project.id}`}>Page URLs, one per line</label>
              <textarea
                id={`urls-${detail.data.project.id}`}
                name="website_urls"
                rows="3"
                aria-describedby={`urls-hint-${detail.data.project.id}`}
              >
                {detail.data.project.website_urls.join('\n')}
              </textarea>
              <p id={`urls-hint-${detail.data.project.id}`} class="mt-1 text-xs text-ink-muted">
                Public pages only: the server refuses localhost, private addresses and anything that
                is not http or https.
              </p>
              <p class="mt-3">
                <Button type="submit" size="sm">
                  Save project
                </Button>
              </p>
            </form>

            <form method="post" action="/api/action">
              <input type="hidden" name="op" value="project.delete" />
              <input type="hidden" name="id" value={detail.data.project.id} />
              <input type="hidden" name="redirect" value="/projects" />
              <div class="checkbox-row">
                <input id={`confirm-${detail.data.project.id}`} type="checkbox" name="confirm" />
                <label for={`confirm-${detail.data.project.id}`}>
                  I understand this deletes the project and its ranking
                </label>
              </div>
              <p class="mt-2">
                <Button type="submit" variant="danger" size="sm">
                  Delete project
                </Button>
              </p>
            </form>
          </div>
        )}
      </Card>
    ))
  }

  <Card title="Add a project" class="mt-6">
    <form method="post" action="/api/action">
      <input type="hidden" name="op" value="project.create" />
      <input type="hidden" name="redirect" value={target} />
      <div class="form-row">
        <div>
          <label for="new-name">Name</label>
          <input id="new-name" name="name" placeholder="VoxTranslate" required />
        </div>
      </div>
      <label for="new-summary">What the product is</label>
      <textarea
        id="new-summary"
        name="summary"
        rows="4"
        aria-describedby="new-summary-hint"
        placeholder="One paragraph: the problem it solves, for whom, in plain words."></textarea>
      <p id="new-summary-hint" class="mt-1 text-xs text-ink-muted">
        This is what the drafting prompts will quote, so describe the problem, not the feature list.
      </p>
      <label for="new-urls">Page URLs, one per line</label>
      <textarea id="new-urls" name="website_urls" rows="3"></textarea>
      <p class="mt-3">
        <Button type="submit" size="sm">Create project</Button>
      </p>
    </form>
  </Card>
</Layout>
