---
import { cva, type VariantProps } from 'class-variance-authority';
import { cn } from '../../lib/cn';

/**
 * Card primitive: the surface every panel in the app uses. It carries the structure (surface,
 * border, radius, shadow) and an optional heading block, and leaves composition to the caller.
 */
const card = cva('rounded-panel border border-line bg-raised shadow-panel', {
  variants: {
    padding: {
      none: 'p-0',
      sm: 'p-3',
      md: 'p-4',
      lg: 'p-5',
    },
  },
  defaultVariants: { padding: 'md' },
});

type Props = VariantProps<typeof card> & {
  /** Visible panel title; rendered as an h2 so page heading levels stay predictable. */
  title?: string;
  description?: string;
  /** Accessible name when the panel has its own visible heading inside the slot. */
  label?: string;
  class?: string;
};

const { title, description, label, padding, class: className } = Astro.props;
/** Deterministic id so the panel's accessible name comes from its visible heading, not a guess. */
const titleId = title
  ? `card-${title
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '')}`
  : undefined;
---

<section
  class={cn(card({ padding }), className)}
  aria-label={title ? undefined : label}
  aria-labelledby={titleId}
>
  {
    (title || description) && (
      <header class="mb-3">
        {title && (
          <h2 id={titleId} class="text-base font-semibold">
            {title}
          </h2>
        )}
        {description && <p class="mt-1 text-xs text-ink-muted">{description}</p>}
      </header>
    )
  }
  <slot />
</section>
