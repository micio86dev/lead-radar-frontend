---
import { cva, type VariantProps } from 'class-variance-authority';
import { cn } from '../../lib/cn';

/**
 * Button primitive. Renders `<a>` when `href` is present and `<button>` otherwise, so the shape
 * follows the semantics instead of a click handler on a link-looking div.
 *
 * Variants are declared with `class-variance-authority`, the same contract shadcn uses, and the
 * caller's `class` is merged last so a page can adjust one property without fighting specificity.
 */
const button = cva(
  [
    'inline-flex items-center justify-center gap-2 rounded-control border font-semibold',
    'transition-colors select-none',
    'disabled:opacity-55 disabled:cursor-not-allowed aria-disabled:cursor-not-allowed',
  ],
  {
    variants: {
      variant: {
        primary:
          'border-accent bg-accent text-accent-ink hover:border-accent-strong hover:bg-accent-strong',
        secondary: 'border-line bg-raised text-ink hover:border-line-strong hover:bg-sunken',
        ghost: 'border-transparent bg-transparent text-ink hover:bg-sunken',
        danger: 'border-bad bg-bad text-white hover:bg-bad/90',
      },
      size: {
        sm: 'min-h-6 px-2.5 py-1 text-xs',
        md: 'min-h-6 px-3.5 py-1.5 text-sm',
        lg: 'min-h-11 px-5 py-2.5 text-base',
      },
      block: {
        true: 'w-full',
        false: '',
      },
    },
    defaultVariants: { variant: 'primary', size: 'md', block: false },
  },
);

type Props = VariantProps<typeof button> & {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  /** Accessible name when the button shows only an icon. */
  label?: string;
  class?: string;
};

const {
  href,
  type = 'button',
  disabled = false,
  variant,
  size,
  block,
  label,
  class: className,
} = Astro.props;

const classes = cn(button({ variant, size, block }), className);
---

{
  href ? (
    <a href={href} class={classes} aria-label={label} aria-disabled={disabled || undefined}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} disabled={disabled} aria-label={label}>
      <slot />
    </button>
  )
}
